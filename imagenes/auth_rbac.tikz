\begin{tikzpicture}[every node/.style={align=center, transform shape}, node distance=3.6cm and 1.2cm]
\tikzset{
  box/.style={draw, rounded corners, fill=blue!10, minimum width=3.8cm, minimum height=0.95cm},
  stepbox/.style={draw, rounded corners, fill=purple!20, minimum width=3.8cm, minimum height=0.95cm}
}
\node[box] (client) {Cliente App};
\node[box, right=of client] (login) {POST /auth/login};
\node[box, right=of login] (jwt) {JWT};
\node[box, right=of jwt] (endpoint) {Endpoint protegido};

\node[stepbox, below=of endpoint] (authguard) {AuthGuard [jwt]};
\node[stepbox, below=of authguard] (rolesguard) {RolesGuard};
\node[stepbox, below=of rolesguard] (controller) {Controller};
\node[stepbox, below=of controller] (service) {Service};
\node[stepbox, below=of service] (response) {Respuesta};

\draw[-latex] (client.east) -- (login.west) node[midway, above] {HTTPS};
\draw[-latex] (login.east) -- (jwt.west) node[midway, above] {Bearer};
\draw[-latex] (jwt.east) -- (endpoint.west);
\draw[-latex] (endpoint.south) -- (authguard.north);
\draw[-latex] (authguard.south) -- (rolesguard.north);
\draw[-latex] (rolesguard.south) -- (controller.north);
\draw[-latex] (controller.south) -- (service.north);
\draw[-latex] (service.south) -- (response.north);
\node[draw, dashed, rounded corners, inner sep=8pt, fit=(endpoint) (authguard) (response)] (api) {};
\node at ([yshift=8pt] api.north) {API protegida};
\end{tikzpicture}
