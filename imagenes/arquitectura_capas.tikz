\begin{tikzpicture}[
  font=\small,
  box/.style={draw, rectangle, align=center, minimum height=1cm, inner sep=6pt, rounded corners=2pt, line width=0.5pt},
  bigbox/.style={box, minimum width=9.5cm},
  midbox/.style={box, minimum width=6.8cm},
  smallbox/.style={box, minimum width=5.8cm},
  line/.style={-{Latex[length=2mm]}, line width=0.5pt},
  usuarios/.style={bigbox, fill=blue!12, draw=blue!60},
  acceso/.style={smallbox, fill=cyan!10, draw=cyan!60},
  presentacion/.style={midbox, fill=orange!12, draw=orange!60},
  servicios/.style={bigbox, fill=purple!10, draw=purple!60},
  datos/.style={smallbox, fill=green!12, draw=green!60},
  inteligencia/.style={smallbox, fill=teal!12, draw=teal!60},
  integracion/.style={smallbox, fill=red!10, draw=red!60}
]
\matrix (m) [column sep=14mm, row sep=10mm] {
  & \node[usuarios] (usuarios) {Capa de usuarios\\Usuarios web / Cliente - Admin}; & \\
  & \node[acceso] (internet) {Capa de acceso\\Internet}; & \\
  \node[presentacion] (web) {Capa de presentación\\Frontend web / Navegador}; &
  \node[servicios] (api) {Capa de servicios\\API Backend REST}; &
  \node[presentacion] (app) {Capa de presentación\\App móvil / Android - iOS}; \\
  \node[datos] (db) {Capa de datos\\Base de datos}; &
  \node[inteligencia] (chat) {Capa de inteligencia\\Chatbot IA / RAG}; &
  \node[integracion] (ext) {Capa de integración\\Servicios externos\\Mapas - Pagos - WhatsApp}; \\
};
\draw[line] (usuarios) -- (internet);
\draw[line] (internet) -- (web);
\draw[line] (internet) -- (app);
\draw[line] (web) -- (api);
\draw[line] (app) -- (api);
\draw[line] (api) -- (db);
\draw[line] (api) -- (chat);
\draw[line] (api) -- (ext);
\end{tikzpicture}
