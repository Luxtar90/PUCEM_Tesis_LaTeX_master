\begin{tikzpicture}[every node/.style={align=center, transform shape}, node distance=1.6cm and 2.6cm]
\tikzset{
  actor/.style={draw, rounded corners, fill=blue!10, minimum width=4.6cm, minimum height=1.1cm},
  admin/.style={draw, rounded corners, fill=purple!15, minimum width=4.6cm, minimum height=1.1cm},
  service/.style={draw, rounded corners, fill=green!15, minimum width=4.8cm, minimum height=1.1cm},
  dbs/.style={draw, rounded corners, fill=orange!20, minimum width=4.6cm, minimum height=1.1cm}
}
\node[actor] (driver) {Repartidor\\App móvil};
\node[service, right=of driver] (backend) {Backend/API\\Repartidores};
\node[dbs, right=of backend] (db) {Base de datos\\Repartidores y pedidos};
\node[admin, below=1.2cm of backend] (admin) {Aprobación\\administrativa};
\draw[-latex] (driver) -- (backend) node[midway, above, text width=2.2cm, align=center, yshift=2pt] {Registro};
\draw[-latex, yshift=4pt] (backend) -- (db) node[midway, above, text width=2.6cm, align=center, yshift=2pt] {Persistencia};
\draw[-latex] (admin) -- (backend) node[midway, right, text width=2.8cm, align=left] {Aprobar o rechazar};
\draw[-latex, yshift=-4pt] (backend) -- (db) node[midway, below, text width=3.0cm, align=center, yshift=-2pt] {Actualizar estado};
\draw[-latex, yshift=-4pt] (backend) -- (driver) node[midway, below, text width=3.2cm, align=center, yshift=-2pt] {Asignación de pedidos};
\end{tikzpicture}
