\begin{tikzpicture}[scale=0.95, every node/.style={align=center, transform shape}]
\tikzset{
  cstep/.style={draw, rounded corners, fill=blue!10, minimum width=3.8cm, minimum height=0.9cm},
  dstep/.style={draw, rounded corners, fill=green!15, minimum width=3.8cm, minimum height=0.9cm}
}
\node[cstep] (cl_login) at (-4,3) {Login y registro};
\node[cstep] (cl_catalog) at (-4,2) {Catálogo};
\node[cstep] (cl_detalle) at (-4,1) {Detalle producto};
\node[cstep] (cl_carrito) at (-4,0) {Carrito};
\node[cstep] (cl_crea) at (-4,-1) {Crear pedido};
\node[cstep] (cl_estado) at (-4,-2) {Estado pedido};
\draw[dashed, rounded corners] (-6,3.5) rectangle (-2,-2.5);
\node at (-4,3.7) {Cliente};
\draw[-latex] (cl_login) -- (cl_catalog);
\draw[-latex] (cl_catalog) -- (cl_detalle);
\draw[-latex] (cl_detalle) -- (cl_carrito);
\draw[-latex] (cl_carrito) -- (cl_crea);
\draw[-latex] (cl_crea) -- (cl_estado);
\node[dstep] (dl_login) at (4,3) {Login};
\node[dstep] (dl_pend) at (4,2) {Pedidos pendientes};
\node[dstep] (dl_asign) at (4,1) {Aceptar y asignar};
\node[dstep] (dl_activo) at (4,0) {Entrega en curso};
\node[dstep] (dl_done) at (4,-1) {Entregado};
\draw[dashed, rounded corners] (2,3.5) rectangle (6,-1.5);
\node at (4,3.7) {Repartidor};
\draw[-latex] (dl_login) -- (dl_pend);
\draw[-latex] (dl_pend) -- (dl_asign);
\draw[-latex] (dl_asign) -- (dl_activo);
\draw[-latex] (dl_activo) -- (dl_done);
\draw[-latex] (cl_crea.east) .. controls (-1,-1) and (1,2) .. (dl_pend.west);
\node at (0,1.1) {Pedido nuevo};
\draw[-latex] (dl_done.west) .. controls (1,-1) and (-1,-2) .. (cl_estado.east);
\node at (0,-1.6) {Entrega confirmada};
\end{tikzpicture}
