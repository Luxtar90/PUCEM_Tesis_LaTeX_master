\begin{tikzpicture}[
  every node/.style={align=center},
  >=stealth
]
% Definir estilos
\tikzset{
  actor/.style={rectangle, draw, rounded corners, minimum width=3.2cm, minimum height=1cm, font=\bfseries},
  actorc/.style={actor, fill=blue!15},
  cocina/.style={actor, fill=yellow!25},
  actord/.style={actor, fill=cyan!20},
  backend/.style={actor, fill=green!20},
  database/.style={actor, fill=orange!25},
  admin/.style={actor, fill=purple!20},
  arrow/.style={->, thick},
  label/.style={font=\small, midway}
}

% Actores (encabezados)
\node[actorc] (cliente) at (0,0) {Cliente};
\node[cocina] (cocina) at (4,0) {Cocina};
\node[actord] (repartidor) at (8,0) {Repartidor};
\node[backend] (api) at (12,0) {Backend/API};
\node[database] (db) at (16,0) {Base de Datos};
\node[admin] (admin) at (20,0) {Admin};

% Líneas de vida (verticales punteadas)
\foreach \x in {0,4,8,12,16,20} {
  \draw[dashed, gray] (\x,-0.7) -- (\x,-18);
}

% Interacciones
\draw[arrow] (0,-1.5) -- (12,-1.5) node[label, above] {1. Registro};
\draw[arrow] (12,-2) -- (16,-2) node[label, above, font=\scriptsize] {crear usuario};

\draw[arrow] (0,-3) -- (12,-3) node[label, above] {2. Login};

\draw[arrow] (0,-4.5) -- (12,-4.5) node[label, above] {3. Crear pedido};
\draw[arrow] (12,-5) -- (16,-5) node[label, above, font=\scriptsize] {guardar};
\node[font=\scriptsize, text=red!70!black] at (14,-5.4) {estado: pendiente};

\draw[arrow] (4,-6.2) -- (12,-6.2) node[label, above] {4. Consultar pendientes};

\draw[arrow] (4,-7.2) -- (12,-7.2) node[label, above] {5. Aceptar pedido};
\draw[arrow] (12,-7.7) -- (16,-7.7) node[label, above, font=\scriptsize] {actualizar};
\node[font=\scriptsize, text=red!70!black] at (14,-8.1) {estado: preparando};

\draw[arrow] (4,-9.2) -- (12,-9.2) node[label, above] {6. Marcar listo};
\draw[arrow] (12,-9.7) -- (16,-9.7) node[label, above, font=\scriptsize] {actualizar};
\node[font=\scriptsize, text=red!70!black] at (14,-10.1) {estado: listo};

\draw[arrow] (8,-11.2) -- (12,-11.2) node[label, above] {7. Ver pedidos listos};

\draw[arrow] (8,-12.5) -- (12,-12.5) node[label, above] {8. Recoger pedido};
\draw[arrow] (12,-13) -- (16,-13) node[label, above, font=\scriptsize] {actualizar};
\node[font=\scriptsize, text=red!70!black] at (14,-13.4) {estado: en\_camino};

\draw[arrow] (8,-14.8) -- (12,-14.8) node[label, above] {9. Entregar pedido};
\draw[arrow] (12,-15.3) -- (16,-15.3) node[label, above, font=\scriptsize] {actualizar};
\node[font=\scriptsize, text=red!70!black] at (14,-15.7) {estado: entregado};

\draw[arrow] (20,-17) -- (12,-17) node[label, above] {10. Consultar pedidos};

\end{tikzpicture}
